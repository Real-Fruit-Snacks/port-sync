// Windows resources for port-sync.exe: the icon, the manifest and the version shown in
// Explorer. build.rs compiles this (rc.exe or windres).
#include <winver.h>

1 ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PS_VERSION_COMMAS
PRODUCTVERSION PS_VERSION_COMMAS
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "RFS"
            VALUE "FileDescription", "port-sync"
            VALUE "FileVersion", PS_VERSION_STR
            VALUE "InternalName", "port-sync"
            VALUE "LegalCopyright", "Copyright (c) 2026 Real-Fruit-Snacks. MIT License."
            VALUE "OriginalFilename", "port-sync.exe"
            VALUE "ProductName", "port-sync"
            VALUE "ProductVersion", PS_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
